    try{
      var data = JSON.parse(ev.target.result);
      if(!data.transactions || !Array.isArray(data.transactions)){ showToast('备份文件格式不对'); return; }
      var count = data.transactions.length;
      if(!confirm('即将导入 '+count+' 条记录，将覆盖本地。继续？')) return;
      state.transactions = data.transactions;
      if(data.savingGoal) state.savingGoal = data.savingGoal;
      saveState(); render(); showToast('已恢复 '+count+' 条记录 ✅');
    }catch(err){ console.error(err); showToast('文件读取失败'); }
  };
  reader.readAsText(file); e.target.value='';
});

var toastTimer = null;
function showToast(msg){
  var el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ el.classList.remove('show'); },1800);
}

loadState();
render();

(function initCloud(){
  var cfg = getCloudConfig();
  if(!cfg.binId || !cfg.binKey) return;
  setCloudStatus('☁️ 已开启','var(--green-soft)');
  setTimeout(function(){
    fetch('https://api.jsonbin.io/v3/b/'+cfg.binId+'/latest', {headers:{'X-Master-Key':cfg.binKey}})
      .then(function(res){ return res.ok ? res.json() : null; })
      .then(function(data){
        if(!data || !data.record) return;
        var remote = data.record;
        if(!remote.transactions) return;
        var remoteCount = remote.transactions.length;
        var remoteTime = remote.updatedAt ? new Date(remote.updatedAt).getTime() : 0;
        var localTime = parseInt(localStorage.getItem('mycost-last')||'0',10);
        if(remoteTime > localTime && remoteCount > 0){
          if(confirm('云端有 '+remoteCount+' 条记录（比本地新），是否用云端覆盖本地？')){
            state.transactions = remote.transactions;
            if(remote.savingGoal) state.savingGoal = remote.savingGoal;
            saveState(); render(); showToast('已同步云端数据 ✅');
          }
        }
      }).catch(function(err){ console.error('自动拉取失败',err); });
  },1000);
})();

window.addEventListener('beforeunload',function(){
  localStorage.setItem('mycost-last', String(Date.now()));
});

})();
</script>
