<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>MyCost</title>
<link rel="apple-touch-icon" href="data:image/svg+xml;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
:root{
  --pink-1:#FFFCFD;--pink-2:#FFF6FA;--pink-3:#FFE9F1;--pink-4:#FFD4E3;--pink-5:#FFB5CC;--pink-6:#E89AB5;
  --text-1:#5A4A50;--text-2:#9A8A90;--text-3:#C5B5BB;--white:#FFFFFF;
  --green-soft:#5BB89A;--red-soft:#FF7A9C;
  --shadow:0 4px 20px rgba(255,181,204,0.18);--shadow-sm:0 2px 10px rgba(255,181,204,0.12);
}
html,body{width:100%;height:100%;overflow:hidden;background-color:#FFFCFD;
  background-image:radial-gradient(circle, #FFE9F1 1.5px, transparent 1.5px),radial-gradient(circle, #FFF0F6 1.5px, transparent 1.5px);
  background-size:22px 22px;background-position:0 0, 11px 11px;color:var(--text-1);
  font-family:'Quicksand','Yuanti SC','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;
  font-size:15px;-webkit-font-smoothing:antialiased;}
body{overscroll-behavior:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,textarea{font-family:inherit;font-size:inherit;color:inherit;border:none;background:none;outline:none;}

.app{position:relative;z-index:1;max-width:480px;margin:0 auto;height:100vh;height:100dvh;display:flex;flex-direction:column;overflow:hidden;}
.app-fixed-top{flex-shrink:0;background-color:#FFFCFD;
  background-image:radial-gradient(circle, #FFE9F1 1.5px, transparent 1.5px),radial-gradient(circle, #FFF0F6 1.5px, transparent 1.5px);
  background-size:22px 22px;background-position:0 0, 11px 11px;
  box-shadow:0 4px 14px rgba(255,181,204,0.08);position:relative;z-index:5;}

.header{padding:16px 18px 8px;}
.savings-card{position:relative;background:linear-gradient(135deg,#FFEDF3 0%,#FFD4E3 100%);border-radius:24px;padding:18px 22px;box-shadow:var(--shadow);overflow:hidden;border:1.5px solid rgba(255,255,255,0.7);cursor:pointer;transition:transform 0.15s;}
.savings-card:active{transform:scale(0.99);}
.savings-card::before{content:'';position:absolute;top:-20px;right:-20px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,0.5);}
.savings-card::after{content:'';position:absolute;bottom:-30px;right:30px;width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,0.35);}
.savings-label{font-size:13px;color:#A86080;font-weight:600;letter-spacing:1px;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1;}
.savings-label .left{display:flex;align-items:center;gap:6px;}
.savings-label .edit-hint{font-size:10px;color:#C08AA0;background:rgba(255,255,255,0.7);padding:3px 8px;border-radius:100px;font-weight:600;letter-spacing:0.3px;}
.savings-label .heart{animation:heartbeat 1.6s ease-in-out infinite;}
@keyframes heartbeat{0%,100%{transform:scale(1);}50%{transform:scale(1.15);}}
.savings-amount{font-family:'ZCOOL KuaiLe','Quicksand',sans-serif;font-size:34px;color:#7A3A55;margin:4px 0 12px;letter-spacing:0.5px;font-variant-numeric:tabular-nums;position:relative;z-index:1;}
.savings-amount .yen{font-size:20px;opacity:0.65;margin-right:2px;}
.goal-section{position:relative;z-index:1;margin-top:4px;}
.goal-header{display:flex;justify-content:space-between;font-size:12px;color:#A86080;font-weight:600;margin-bottom:6px;}
.goal-bar{height:8px;background:rgba(255,255,255,0.7);border-radius:4px;overflow:hidden;}
.goal-fill{height:100%;background:linear-gradient(90deg,#FFB5CC,#E89AB5);border-radius:4px;transition:width 0.4s ease;}

/* 新增：独立快捷操作条 */
.quick-actions{display:flex;gap:8px;margin-top:10px;}
.quick-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:4px;background:var(--white);border:1.5px dashed var(--pink-4);border-radius:14px;padding:9px 6px;font-size:12px;color:var(--text-2);font-weight:600;letter-spacing:0.3px;cursor:pointer;transition:all 0.15s;-webkit-tap-highlight-color:transparent;}
.quick-btn:active{transform:scale(0.96);background:var(--pink-2);border-color:var(--pink-5);}
.quick-btn .q-icon{font-size:14px;line-height:1;}

.summary-card{display:flex;gap:10px;margin-top:12px;}
.summary-item{flex:1;background:var(--white);border-radius:18px;padding:12px 16px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);}
.summary-label{font-size:11px;color:var(--text-3);letter-spacing:0.5px;margin-bottom:4px;display:flex;align-items:center;gap:4px;}
.summary-label .dot{width:6px;height:6px;border-radius:50%;}
.summary-label .dot.income{background:var(--green-soft);}
.summary-label .dot.expense{background:var(--red-soft);}
.summary-value{font-size:18px;font-weight:700;color:var(--text-1);font-variant-numeric:tabular-nums;}
.summary-value.income{color:var(--green-soft);}
.summary-value.expense{color:var(--red-soft);}

.tabs{display:flex;gap:6px;margin:12px 18px 0;background:rgba(255,255,255,0.75);border-radius:20px;padding:5px;box-shadow:var(--shadow-sm);border:1.5px solid var(--pink-3);}
.tab-btn{flex:1;padding:10px 6px;border-radius:16px;font-size:14px;font-weight:600;color:var(--text-2);transition:all 0.25s ease;letter-spacing:0.5px;}
.tab-btn.active{background:linear-gradient(135deg,#FFE9F1,#FFD4E3);color:#7A3A55;box-shadow:0 3px 10px rgba(255,181,204,0.35);}

.date-nav{display:flex;align-items:center;justify-content:space-between;padding:12px 24px 10px;}
.date-nav-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--white);color:var(--pink-6);font-size:18px;font-weight:700;box-shadow:var(--shadow-sm);border:1.5px solid var(--pink-3);transition:transform 0.15s;}
.date-nav-btn:active{transform:scale(0.92);}
.date-nav-title{font-family:'ZCOOL KuaiLe',sans-serif;font-size:17px;color:var(--text-1);letter-spacing:1px;}

.main{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior-y:contain;padding:4px 18px 110px;}
.main::-webkit-scrollbar{width:0;display:none;}

.day-summary{display:flex;gap:10px;margin-bottom:8px;}
.day-summary-item{flex:1;background:var(--white);border-radius:16px;padding:12px 14px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);text-align:center;}
.day-summary-item .k{font-size:11px;color:var(--text-3);margin-bottom:2px;}
.day-summary-item .v{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;}
.day-summary-item .v.income{color:var(--green-soft);}
.day-summary-item .v.expense{color:var(--red-soft);}
.press-hint{text-align:center;font-size:11px;color:var(--text-3);padding:6px 0 12px;letter-spacing:0.5px;font-weight:500;display:flex;align-items:center;justify-content:center;gap:5px;opacity:0.8;}
.press-hint .dot{width:4px;height:4px;border-radius:50%;background:var(--pink-4);}
.tx-list{display:flex;flex-direction:column;gap:10px;}
.tx-item{display:flex;align-items:center;gap:12px;background:var(--white);border-radius:18px;padding:12px 14px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);position:relative;transition:transform 0.15s,background 0.2s,border-color 0.2s;touch-action:pan-y;-webkit-user-select:none;user-select:none;}
.tx-item.pressing{transform:scale(0.97);background:linear-gradient(135deg,#FFF6FA,#FFE9F1);border-color:var(--pink-5);border-style:solid;}
.tx-emoji{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.tx-info{flex:1;min-width:0;}
.tx-name{font-size:14px;font-weight:600;color:var(--text-1);}
.tx-note{font-size:12px;color:var(--text-3);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tx-amount{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;flex-shrink:0;}
.tx-amount.expense{color:var(--red-soft);}
.tx-amount.income{color:var(--green-soft);}
.empty-state{text-align:center;padding:50px 20px;color:var(--text-3);}
.empty-state .emoji{font-size:40px;margin-bottom:14px;display:block;opacity:0.5;letter-spacing:4px;}
.empty-state .text{font-size:14px;line-height:1.7;}

.month-summary-top{display:flex;gap:10px;margin-bottom:12px;}
.month-summary-top .item{flex:1;background:var(--white);border-radius:18px;padding:14px 16px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);text-align:center;position:relative;overflow:hidden;}
.month-summary-top .item::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:18px 18px 0 0;}
.month-summary-top .item.income-item::before{background:linear-gradient(90deg,transparent,#A8DBC8,transparent);}
.month-summary-top .item.expense-item::before{background:linear-gradient(90deg,transparent,#FFB5CC,transparent);}
.month-summary-top .item .k{font-size:11px;color:var(--text-3);font-weight:600;margin-bottom:5px;letter-spacing:0.5px;}
.month-summary-top .item .v{font-family:'ZCOOL KuaiLe','Quicksand',sans-serif;font-size:19px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:0.3px;}
.month-summary-top .item .v.income{color:var(--green-soft);}
.month-summary-top .item .v.expense{color:var(--red-soft);}
.month-summary-top .item .v.empty{color:var(--text-3);}

.calendar{background:var(--white);border-radius:22px;padding:16px 10px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);}
.calendar-weekdays{display:grid;grid-template-columns:repeat(7,1fr);margin-bottom:8px;}
.calendar-weekdays .wd{text-align:center;font-size:11px;color:var(--text-3);font-weight:600;padding:6px 0;}
.calendar-weekdays .wd.sun{color:var(--pink-6);}
.calendar-weekdays .wd.sat{color:#8FB8D8;}
.calendar-days{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;}
.cal-day{aspect-ratio:0.85;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;border-radius:12px;cursor:pointer;transition:all 0.15s;padding:5px 2px 3px;position:relative;min-height:0;}
.cal-day:active{transform:scale(0.92);}
.cal-day.other-month{opacity:0.22;}
.cal-day.today{background:linear-gradient(135deg,#FFE9F1,#FFD4E3);box-shadow:0 2px 8px rgba(255,181,204,0.3);}
.cal-day.has-tx{background:rgba(255,246,250,0.9);}
.cal-day.today.has-tx{background:linear-gradient(135deg,#FFE9F1,#FFD4E3);}
.cal-day .num{font-size:12px;font-weight:700;color:var(--text-1);font-variant-numeric:tabular-nums;line-height:1.1;}
.cal-day.today .num{color:#7A3A55;}
.cal-day .amts{display:flex;flex-direction:column;align-items:center;width:100%;margin-top:3px;gap:2px;}
.cal-day .amt{font-size:11px;font-weight:700;line-height:1.05;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;max-width:100%;letter-spacing:-0.3px;}
.cal-day .amt.income{color:var(--green-soft);}
.cal-day .amt.expense{color:var(--red-soft);}

.year-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;padding:0 4px;}
.year-toolbar-title{font-family:'ZCOOL KuaiLe',sans-serif;font-size:15px;color:var(--text-1);letter-spacing:1px;}
.year-detail-btn{display:flex;align-items:center;gap:5px;background:linear-gradient(135deg,#FFE9F1,#FFD4E3);color:#7A3A55;padding:7px 14px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:0.5px;box-shadow:0 2px 8px rgba(255,181,204,0.3);border:1.5px solid rgba(255,255,255,0.7);transition:transform 0.15s;}
.year-detail-btn:active{transform:scale(0.95);}
.year-detail-btn .icon{font-size:14px;}
.year-summary-top{display:flex;gap:10px;margin-bottom:16px;}
.year-summary-top .item{flex:1;background:var(--white);border-radius:18px;padding:16px 18px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);text-align:center;position:relative;overflow:hidden;}
.year-summary-top .item::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:18px 18px 0 0;}
.year-summary-top .item.income-item::before{background:linear-gradient(90deg,transparent,#A8DBC8,transparent);}
.year-summary-top .item.expense-item::before{background:linear-gradient(90deg,transparent,#FFB5CC,transparent);}
.year-summary-top .item .k{font-size:11px;color:var(--text-3);font-weight:600;margin-bottom:6px;letter-spacing:0.5px;}
.year-summary-top .item .v{font-family:'ZCOOL KuaiLe','Quicksand',sans-serif;font-size:22px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:0.5px;}
.year-summary-top .item .v.income{color:var(--green-soft);}
.year-summary-top .item .v.expense{color:var(--red-soft);}
.year-summary-top .item .v.empty{color:var(--text-3);}
.month-list{display:flex;flex-direction:column;gap:10px;}
.month-card-v{background:var(--white);border-radius:18px;padding:14px 16px;box-shadow:var(--shadow-sm);border:1.5px dashed var(--pink-4);cursor:pointer;transition:all 0.15s;}
.month-card-v:active{transform:scale(0.99);background:linear-gradient(135deg,#FFFCFD,#FFF6FA);}
.month-card-v.current{border-style:solid;border-color:var(--pink-5);box-shadow:0 4px 14px rgba(255,181,204,0.3);}
.mc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.mc-month-v{font-family:'ZCOOL KuaiLe',sans-serif;font-size:18px;color:#7A3A55;display:flex;align-items:baseline;gap:3px;}
.mc-month-v .unit{font-size:11px;color:var(--text-3);font-family:'Quicksand',sans-serif;font-weight:600;}
.mc-current-tag{font-size:10px;color:#7A3A55;background:linear-gradient(135deg,#FFE9F1,#FFD4E3);padding:3px 9px;border-radius:100px;font-weight:700;letter-spacing:0.5px;}
.mc-body-v{display:flex;flex-direction:column;gap:6px;}
.mc-row-v{display:flex;justify-content:space-between;align-items:baseline;}
.mc-label-v{font-size:12px;color:var(--text-3);font-weight:600;letter-spacing:0.3px;}
.mc-value-v{font-size:15px;font-weight:700;font-variant-numeric:tabular-nums;}
.mc-value-v.income{color:var(--green-soft);}
.mc-value-v.expense{color:var(--red-soft);}
.mc-value-v.empty{color:var(--text-3);}
.mc-bar-v{height:5px;background:var(--pink-3);border-radius:3px;margin-top:6px;overflow:hidden;}
.mc-bar-fill-v{height:100%;background:linear-gradient(90deg,#FFD4E3,#FFB5CC);border-radius:3px;transition:width 0.4s ease;}
.year-empty{text-align:center;padding:60px 20px;color:var(--text-3);}
.year-empty .emoji{font-size:40px;margin-bottom:14px;display:block;opacity:0.5;}
.year-empty .text{font-size:14px;line-height:1.7;}

.fab{position:fixed;bottom:30px;right:calc(50% - 240px + 24px);width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#FFB5CC,#E89AB5);color:var(--white);font-size:32px;font-weight:300;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 24px rgba(232,154,181,0.45);z-index:50;transition:transform 0.2s ease,box-shadow 0.2s ease;line-height:1;padding-bottom:3px;}
.fab:active{transform:scale(0.92);box-shadow:0 3px 12px rgba(232,154,181,0.35);}
@media (max-width:520px){.fab{right:24px;}}

.modal{position:fixed;inset:0;background:rgba(122,58,85,0.3);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:100;display:none;align-items:flex-end;justify-content:center;}
.modal.open{display:flex;}
.modal-content{background:var(--pink-1);width:100%;max-width:480px;border-radius:28px 28px 0 0;padding:20px 20px 30px;max-height:92vh;overflow-y:auto;animation:slideUp 0.28s cubic-bezier(0.34,1.2,0.64,1);position:relative;}
@keyframes slideUp{from{transform:translateY(100%);}to{transform:translateY(0);}}
.modal-handle{width:40px;height:4px;background:var(--pink-4);border-radius:2px;margin:0 auto 16px;}
.modal-title{font-family:'ZCOOL KuaiLe',sans-serif;font-size:18px;color:var(--text-1);text-align:center;margin-bottom:18px;letter-spacing:1px;}

.goal-input-row{display:flex;align-items:center;gap:10px;background:var(--white);border-radius:16px;padding:14px 18px;box-shadow:var(--shadow-sm);border:2px dashed var(--pink-4);margin-bottom:12px;}
.goal-input-row .icon{font-size:18px;flex-shrink:0;}
.goal-input-row .prefix{font-size:20px;color:var(--pink-6);font-weight:700;flex-shrink:0;}
.goal-input-row input{flex:1;font-size:18px;font-weight:700;color:var(--text-1);text-align:right;font-variant-numeric:tabular-nums;min-width:0;font-family:inherit;}
.goal-input-row input::placeholder{color:var(--text-3);font-weight:500;}
.goal-input-row input[type="text"].left-align{text-align:left;font-size:15px;font-weight:600;}
.goal-field-label{font-size:12px;color:var(--text-3);font-weight:600;letter-spacing:0.5px;margin:0 4px 6px;}

.type-tabs{display:flex;gap:6px;background:var(--white);border-radius:16px;padding:4px;margin-bottom:18px;box-shadow:var(--shadow-sm);border:1.5px solid var(--pink-3);}
.type-tab{flex:1;padding:10px;border-radius:12px;font-size:14px;font-weight:700;color:var(--text-2);transition:all 0.2s;}
.type-tab.active.expense{background:linear-gradient(135deg,#FFE9F1,#FFD4E3);color:#7A3A55;}
.type-tab.active.income{background:linear-gradient(135deg,#DCF2E7,#B8E0D0);color:#1A4A3A;}
.amount-display{background:var(--white);border-radius:20px;padding:18px 22px;margin-bottom:16px;box-shadow:var(--shadow-sm);display:flex;align-items:center;justify-content:space-between;border:2px dashed var(--pink-4);}
.amount-display .prefix{font-size:24px;color:var(--pink-6);font-weight:700;}
.amount-input{flex:1;font-size:36px;font-weight:700;font-family:'ZCOOL KuaiLe','Quicksand',sans-serif;color:var(--text-1);text-align:right;font-variant-numeric:tabular-nums;min-width:0;}
.amount-input::placeholder{color:var(--text-3);font-weight:400;}
.calc-btn{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#FFE9F1,#FFD4E3);display:flex;align-items:center;justify-content:center;font-size:20px;margin-left:10px;flex-shrink:0;box-shadow:0 2px 6px rgba(255,181,204,0.3);}
.section-title{font-size:12px;color:var(--text-3);letter-spacing:1px;font-weight:600;margin:14px 4px 8px;}
.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
.cat-item{background:var(--white);border-radius:14px;padding:10px 4px 8px;display:flex;flex-direction:column;align-items:center;gap:4px;box-shadow:var(--shadow-sm);border:2px solid transparent;transition:all 0.2s;cursor:pointer;}
.cat-item:active{transform:scale(0.94);}
.cat-item.selected{border-color:var(--pink-5);background:linear-gradient(135deg,#FFF6FA,#FFE9F1);box-shadow:0 4px 12px rgba(255,181,204,0.3);}
.cat-emoji{font-size:22px;}
.cat-name{font-size:10px;color:var(--text-2);font-weight:600;}
.note-input{width:100%;background:var(--white);border-radius:16px;padding:14px 18px;font-size:14px;box-shadow:var(--shadow-sm);border:2px dashed var(--pink-4);resize:none;min-height:52px;font-family:inherit;color:var(--text-1);}
.note-input::placeholder{color:var(--text-3);}
.date-row{display:flex;align-items:center;gap:10px;background:var(--white);border-radius:16px;padding:12px 18px;box-shadow:var(--shadow-sm);border:2px dashed var(--pink-4);}
.date-row .label{font-size:13px;color:var(--text-2);font-weight:600;}
.date-row input{flex:1;font-size:14px;font-weight:600;color:var(--text-1);text-align:right;}
.modal-actions{display:flex;gap:10px;margin-top:20px;}
.btn{flex:1;padding:16px;border-radius:16px;font-size:15px;font-weight:700;letter-spacing:1px;transition:transform 0.15s;}
.btn:active{transform:scale(0.97);}
.btn-primary{background:linear-gradient(135deg,#FFB5CC,#E89AB5);color:var(--white);box-shadow:0 6px 16px rgba(232,154,181,0.35);}
.btn-secondary{background:var(--white);color:var(--text-2);border:2px dashed var(--pink-4);}

.calc-display{background:var(--white);border-radius:18px;padding:18px 22px;margin-bottom:14px;box-shadow:var(--shadow-sm);border:2px dashed var(--pink-4);text-align:right;min-height:76px;display:flex;flex-direction:column;justify-content:center;}
.calc-expr{font-size:14px;color:var(--text-3);min-height:18px;word-break:break-all;font-variant-numeric:tabular-nums;}
.calc-result{font-size:30px;font-weight:700;font-family:'ZCOOL KuaiLe','Quicksand',sans-serif;color:var(--text-1);font-variant-numeric:tabular-nums;margin-top:4px;word-break:break-all;}
.calc-keys{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;}
.calc-key{aspect-ratio:1.55;border-radius:14px;background:var(--white);font-size:20px;font-weight:600;color:var(--text-1);box-shadow:var(--shadow-sm);transition:transform 0.1s,background 0.2s;display:flex;align-items:center;justify-content:center;font-family:'Quicksand',sans-serif;}
.calc-key:active{transform:scale(0.92);background:var(--pink-3);}
.calc-key.op{color:var(--pink-6);font-weight:700;}
.calc-key.eq{background:linear-gradient(135deg,#FFB5CC,#E89AB5);color:var(--white);}
.calc-key.eq:active{background:linear-gradient(135deg,#E89AB5,#D48BA6);}
.calc-key.fn{background:linear-gradient(135deg,#FFE9F1,#FFD4E3);color:#7A3A55;font-size:16px;font-weight:700;}
.calc-key.zero{grid-column:span 2;aspect-ratio:3.2;}

.detail-tabs{display:flex;gap:6px;background:var(--white);border-radius:16px;padding:4px;margin-bottom:16px;box-shadow:var(--shadow-sm);border:1.5px solid var(--pink-3);}
.detail-tab{flex:1;padding:9px;border-radius:12px;font-size:13px;font-weight:700;color:var(--text-2);transition:all 0.2s;letter-spacing:0.5px;}
.detail-tab.active.expense{background:linear-gradient(135deg,#FFE9F1,#FFD4E3);color:#7A3A55;}
.detail-tab.active.income{background:linear-gradient(135deg,#DCF2E7,#B8E0D0);color:#1A4A3A;}
.detail-chart{display:flex;justify-content:center;margin-bottom:18px;min-height:120px;align-items:center;}
.detail-chart svg{width:220px;height:220px;}
.detail-total{text-align:center;padding:14px;background:linear-gradient(135deg,#FFF6FA,#FFE9F1);border-radius:16px;margin-bottom:16px;border:1.5px dashed var(--pink-4);transition:background 0.3s;}
.detail-total.income{background:linear-gradient(135deg,#EFFAF4,#DCF2E7);}
.detail-total .k{font-size:11px;color:var(--text-3);font-weight:600;letter-spacing:1px;margin-bottom:4px;}
.detail-total .v{font-family:'ZCOOL KuaiLe','Quicksand',sans-serif;font-size:26px;font-weight:700;color:#7A3A55;font-variant-numeric:tabular-nums;}
.detail-total.income .v{color:#2E7A5A;}
.detail-legend{display:flex;flex-direction:column;gap:8px;}
.detail-legend .legend-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;background:var(--white);border:1.5px dashed var(--pink-4);}
.detail-legend .legend-color{width:14px;height:14px;border-radius:4px;flex-shrink:0;}
.detail-legend .legend-name{flex:1;font-size:13px;font-weight:600;color:var(--text-1);}
.detail-legend .legend-name .pct{font-size:11px;color:var(--text-3);font-weight:500;margin-left:6px;}
.detail-legend .legend-amount{font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;}
.detail-legend .legend-amount.expense{color:var(--red-soft);}
.detail-legend .legend-amount.income{color:var(--green-soft);}
.detail-empty{text-align:center;padding:40px 20px;color:var(--text-3);font-size:13px;}

.toast{position:fixed;top:60px;left:50%;transform:translate(-50%,-20px);background:rgba(122,58,85,0.9);color:var(--white);padding:10px 20px;border-radius:100px;font-size:13px;font-weight:600;letter-spacing:0.5px;z-index:200;opacity:0;pointer-events:none;transition:all 0.3s ease;}
.toast.show{opacity:1;transform:translate(-50%,0);}
::-webkit-scrollbar{width:0;display:none;}
</style>
</head>
<body>

<div class="app">
  <div class="app-fixed-top">
    <div class="header">
      <div class="savings-card" id="savingsCard">
        <div class="savings-label">
          <div class="left">
            <span class="heart">💗</span>
            <span>我的小金库</span>
          </div>
          <span class="edit-hint">编辑目标</span>
        </div>
        <div class="savings-amount">
          <span class="yen">¥</span><span id="savingsAmount">0.00</span>
        </div>
        <div class="goal-section">
          <div class="goal-header">
            <span id="goalName">存钱目标</span>
            <span id="goalProgress">0 / 10000</span>
          </div>
          <div class="goal-bar">
            <div class="goal-fill" id="goalFill" style="width:0%"></div>
          </div>
        </div>
      </div>

      <!-- 独立快捷按钮条 -->
      <div class="quick-actions">
        <button class="quick-btn" id="cloudBtn" type="button">
          <span class="q-icon">☁️</span><span>云同步</span>
        </button>
        <button class="quick-btn" id="exportBtn" type="button">
          <span class="q-icon">📤</span><span>导出</span>
        </button>
        <button class="quick-btn" id="importBtn" type="button">
          <span class="q-icon">📥</span><span>导入</span>
        </button>
      </div>

      <div class="summary-card">
        <div class="summary-item">
          <div class="summary-label"><span class="dot income"></span>本月收入</div>
          <div class="summary-value income" id="monthIncome">¥0</div>
        </div>
        <div class="summary-item">
          <div class="summary-label"><span class="dot expense"></span>本月支出</div>
          <div class="summary-value expense" id="monthExpense">¥0</div>
        </div>
      </div>
    </div>

    <div class="tabs">
      <button class="tab-btn" data-view="day">日账</button>
      <button class="tab-btn active" data-view="month">月账</button>
      <button class="tab-btn" data-view="year">年账</button>
    </div>

    <div class="date-nav">
      <button class="date-nav-btn" id="navPrev">‹</button>
      <div class="date-nav-title" id="navTitle"></div>
      <button class="date-nav-btn" id="navNext">›</button>
    </div>
  </div>

  <div class="main" id="mainArea"></div>
</div>

<button class="fab" id="fabAdd">+</button>

<!-- 存钱目标弹窗 -->
<div class="modal" id="goalModal">
  <div class="modal-content" style="max-width:400px;">
    <div class="modal-handle"></div>
    <div class="modal-title">✎ 设置存钱目标</div>
    <div class="goal-field-label">目标名称</div>
    <div class="goal-input-row">
      <span class="icon">🎯</span>
      <input type="text" id="goalNameInput" class="left-align" placeholder="例如：去旅行 / 买相机" maxlength="20">
    </div>
    <div class="goal-field-label">目标金额</div>
    <div class="goal-input-row">
      <span class="prefix">¥</span>
      <input type="text" id="goalAmountInput" inputmode="decimal" placeholder="0">
    </div>
    <div class="modal-actions">
      <button class="btn btn-secondary" id="goalCancel">取消</button>
      <button class="btn btn-primary" id="goalSave">保存</button>
    </div>
  </div>
</div>

<!-- 云同步弹窗 -->
<div class="modal" id="cloudModal">
  <div class="modal-content" style="max-width:420px;">
    <div class="modal-handle"></div>
    <div class="modal-title">☁️ 云同步设置</div>
    <div class="goal-field-label">Bin ID</div>
    <div class="goal-input-row">
      <span class="icon">📦</span>
      <input type="text" id="binIdInput" class="left-align" placeholder="从 jsonbin.io 获取">
    </div>
    <div class="goal-field-label">X-Master-Key</div>
    <div class="goal-input-row">
      <span class="icon">🔑</span>
      <input type="text" id="binKeyInput" class="left-align" placeholder="$2a$10$...">
    </div>
    <div style="font-size:11px;color:var(--text-3);padding:0 4px 12px;line-height:1.6;">
      开启后每次记账会自动上传到云端。<br>换手机时在这里填同样的 Bin ID / Key，点下方"从云端恢复"即可。
    </div>
    <div class="modal-actions">
      <button class="btn btn-secondary" id="cloudRestore">从云端恢复</button>
      <button class="btn btn-primary" id="cloudSave">保存</button>
    </div>
    <div class="modal-actions" style="margin-top:10px;">
      <button class="btn btn-secondary" id="cloudCancel" style="flex:1;">关闭</button>
    </div>
    <div style="text-align:center;font-size:11px;color:var(--text-3);margin-top:12px;" id="cloudStatus">未开启云同步</div>
  </div>
</div>

<!-- 记账弹窗 -->
<div class="modal" id="addModal">
  <div class="modal-content">
    <div class="modal-handle"></div>
    <div class="type-tabs">
      <button class="type-tab expense active" data-type="expense">支出</button>
      <button class="type-tab income" data-type="income">收入</button>
    </div>
    <div class="amount-display">
      <span class="prefix">¥</span>
      <input class="amount-input" id="amountInput" type="text" inputmode="decimal" placeholder="0.00">
      <button class="calc-btn" id="openCalcBtn">🧮</button>
    </div>
    <div class="section-title">选择类别</div>
    <div class="category-grid" id="categoryGrid"></div>
    <div class="section-title">备注</div>
