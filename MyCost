  </div>
</div>

<div class="toast" id="toast"></div>
<input type="file" id="backupFileInput" accept=".json" style="display:none;">

<script>
(function(){
'use strict';

var STORAGE_KEY = 'mycost-v6';
var CLOUD_CFG_KEY = 'mycost-cloud-v1';

var CATEGORIES = {
  expense: [
    { id:'food', name:'餐饮', emoji:'🍰', bg:'#FFF0F5', chartColor:'#FFB5C8' },
    { id:'trans', name:'交通', emoji:'🚌', bg:'#EAF3FA', chartColor:'#B5D8F0' },
    { id:'pet', name:'宠物', emoji:'🐾', bg:'#FFF6E6', chartColor:'#FFD9A8' },
    { id:'cloth', name:'服饰', emoji:'👗', bg:'#F2EAF8', chartColor:'#D8B8E8' },
    { id:'beauty', name:'美妆', emoji:'💄', bg:'#FFF0F5', chartColor:'#FFC8D5' },
    { id:'gift', name:'礼物', emoji:'🎁', bg:'#FFEBF1', chartColor:'#F5A8C5' },
    { id:'daily', name:'日用', emoji:'🧴', bg:'#EBF7EE', chartColor:'#B8E0C8' },
    { id:'fun', name:'娱乐', emoji:'🎮', bg:'#E8F4F8', chartColor:'#A8D8E8' },
    { id:'health', name:'医疗', emoji:'💊', bg:'#FFF3E8', chartColor:'#FFC8A8' },
    { id:'study', name:'学习', emoji:'📚', bg:'#EDF0FA', chartColor:'#A8B8E8' },
    { id:'home', name:'居家', emoji:'🏠', bg:'#FFF8E6', chartColor:'#FFDCA8' },
    { id:'other', name:'其他', emoji:'✨', bg:'#F2EFF8', chartColor:'#D8D0E8' }
  ],
  income: [
    { id:'salary', name:'工资', emoji:'💰', bg:'#FFF6E6', chartColor:'#B8E0C8' },
    { id:'bonus', name:'奖金', emoji:'🎉', bg:'#FFF0F5', chartColor:'#A8DBC8' },
    { id:'redpack', name:'红包', emoji:'🧧', bg:'#FFEBF1', chartColor:'#C8E8C8' },
    { id:'refund', name:'退款', emoji:'💸', bg:'#EAF3FA', chartColor:'#B5D8D8' },
    { id:'side', name:'兼职', emoji:'💼', bg:'#EBF7EE', chartColor:'#98D8B8' },
    { id:'invest', name:'理财', emoji:'📈', bg:'#EDF0FA', chartColor:'#A8C8E8' },
    { id:'gift_in', name:'礼金', emoji:'🎀', bg:'#FFF0F5', chartColor:'#FFC8D5' },
    { id:'other_in', name:'其他', emoji:'✨', bg:'#F2EFF8', chartColor:'#D8D0E8' }
  ]
};

var WEEKDAYS = ['日','一','二','三','四','五','六'];
var LONG_PRESS_MS = 600;
var MOVE_THRESHOLD = 12;

var state = {
  transactions: [], view: 'month', focusDate: new Date(),
  currentType: 'expense', selectedCategory: null, calcExpr: '',
  savingGoal: { name:'存钱目标', amount: 10000 }, detailType: 'expense'
};

function saveState(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ transactions: state.transactions, savingGoal: state.savingGoal }));
    if(typeof scheduleCloudSync === 'function') scheduleCloudSync();
  }catch(e){ console.error('保存失败', e); }
}
function loadState(){
  try{
    var raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return;
    var data = JSON.parse(raw);
    state.transactions = data.transactions || [];
    if(data.savingGoal) state.savingGoal = data.savingGoal;
  }catch(e){ console.error('读取失败', e); }
}

function pad2(n){ return String(n).padStart(2,'0'); }
function formatDate(d){ return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate()); }
function formatCurrency(n){
  var num = Number(n) || 0, s = num.toFixed(2), parts = s.split('.');
  return parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + parts[1];
}
function formatShort(n){
  var num = Number(n) || 0;
  if(num >= 10000) return (num/10000).toFixed(1) + 'w';
  if(num >= 1000) return (num/1000).toFixed(1) + 'k';
  return Math.round(num).toString();
}
function formatCal(n){
  var num = Number(n) || 0;
  if(num >= 10000) return (num/10000).toFixed(1) + 'w';
  if(num >= 1000) return (num/1000).toFixed(1) + 'k';
  return Math.round(num).toString();
}
function getCategoryById(type, id){
  var list = CATEGORIES[type];
  for(var i=0;i<list.length;i++){ if(list[i].id===id) return list[i]; }
  return list[list.length-1];
}
function isSameDay(d1,d2){ return d1.getFullYear()===d2.getFullYear() && d1.getMonth()===d2.getMonth() && d1.getDate()===d2.getDate(); }
function escapeHtml(str){ return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }

function getSavings(){
  var total = 0;
  for(var i=0;i<state.transactions.length;i++){
    var t = state.transactions[i];
    total += (t.type==='income'? 1 : -1) * t.amount;
  }
  return total;
}
function getDayTotal(date, type){
  var key = formatDate(date), sum = 0;
  for(var i=0;i<state.transactions.length;i++){
    var t = state.transactions[i];
    if(t.date===key && t.type===type) sum += t.amount;
  }
  return sum;
}
function getDayTransactions(date){
  var key = formatDate(date);
  return state.transactions.filter(function(t){ return t.date===key; })
    .sort(function(a,b){ return (b.createdAt||0)-(a.createdAt||0); });
}
function getMonthTotal(year, month, type){
  var sum = 0, prefix = year+'-'+pad2(month+1);
  for(var i=0;i<state.transactions.length;i++){
    var t = state.transactions[i];
    if(t.date.indexOf(prefix)===0 && t.type===type) sum += t.amount;
  }
  return sum;
}

function renderHeader(){
  document.getElementById('savingsAmount').textContent = formatCurrency(getSavings());
  var goal = state.savingGoal;
  document.getElementById('goalName').textContent = goal.name;
  var progress = goal.amount > 0 ? Math.max(0, Math.min(1, getSavings()/goal.amount)) : 0;
  document.getElementById('goalProgress').textContent = '¥'+formatShort(getSavings())+' / ¥'+formatShort(goal.amount);
  document.getElementById('goalFill').style.width = (progress*100)+'%';
  var now = state.focusDate;
  document.getElementById('monthIncome').textContent = '¥'+formatShort(getMonthTotal(now.getFullYear(), now.getMonth(), 'income'));
  document.getElementById('monthExpense').textContent = '¥'+formatShort(getMonthTotal(now.getFullYear(), now.getMonth(), 'expense'));
}

function render(){
  renderHeader(); renderNavTitle();
  var main = document.getElementById('mainArea');
  main.innerHTML = '';
  if(state.view==='day') renderDay(main);
  else if(state.view==='month') renderMonth(main);
  else renderYear(main);
  document.querySelectorAll('.tab-btn').forEach(function(btn){
    btn.classList.toggle('active', btn.dataset.view===state.view);
  });
  main.scrollTop = 0;
}

function renderNavTitle(){
  var d = state.focusDate, t = document.getElementById('navTitle');
  if(state.view==='day') t.textContent = d.getFullYear()+'年'+(d.getMonth()+1)+'月'+d.getDate()+'日 周'+WEEKDAYS[d.getDay()];
  else if(state.view==='month') t.textContent = d.getFullYear()+'年'+(d.getMonth()+1)+'月';
  else t.textContent = d.getFullYear()+'年';
}

function renderDay(container){
  var d = state.focusDate;
  var dayIncome = getDayTotal(d,'income'), dayExpense = getDayTotal(d,'expense');
  var summary = document.createElement('div');
  summary.className = 'day-summary';
  summary.innerHTML = '<div class="day-summary-item"><div class="k">收入</div><div class="v income">+¥'+formatShort(dayIncome)+'</div></div><div class="day-summary-item"><div class="k">支出</div><div class="v expense">-¥'+formatShort(dayExpense)+'</div></div>';
  container.appendChild(summary);
  var list = getDayTransactions(d);
  if(list.length>0){
    var hint = document.createElement('div');
    hint.className = 'press-hint';
    hint.innerHTML = '<span class="dot"></span><span>长按记录可删除</span><span class="dot"></span>';
    container.appendChild(hint);
  }
  if(list.length===0){
    var empty = document.createElement('div');
    empty.className = 'empty-state';
    empty.innerHTML = '<span class="emoji">· · ·</span><div class="text">今天还没有记账哦<br>点击右下角 + 记录第一笔吧～</div>';
    container.appendChild(empty); return;
  }
  var txList = document.createElement('div');
  txList.className = 'tx-list';
  list.forEach(function(t){
    var cat = getCategoryById(t.type, t.category);
    var item = document.createElement('div');
    item.className = 'tx-item';
    var sign = t.type==='income'?'+':'-', cls = t.type==='income'?'income':'expense';
    item.innerHTML = '<div class="tx-emoji" style="background:'+cat.bg+'">'+cat.emoji+'</div><div class="tx-info"><div class="tx-name">'+cat.name+'</div>'+(t.note?'<div class="tx-note">'+escapeHtml(t.note)+'</div>':'')+'</div><div class="tx-amount '+cls+'">'+sign+'¥'+formatCurrency(t.amount)+'</div>';
    attachLongPress(item, function(){ deleteTransaction(t.id); });
    txList.appendChild(item);
  });
  container.appendChild(txList);
}

function attachLongPress(el, onTrigger){
  var timer = null, startX = 0, startY = 0, triggered = false;
  function start(x,y){ startX=x; startY=y; triggered=false; clearTimeout(timer); el.classList.add('pressing');
    timer = setTimeout(function(){ triggered=true; if(navigator.vibrate){ try{navigator.vibrate(30);}catch(e){} } onTrigger(); }, LONG_PRESS_MS); }
  function cancel(){ clearTimeout(timer); el.classList.remove('pressing'); }
  function moved(x,y){ if(Math.sqrt((x-startX)*(x-startX)+(y-startY)*(y-startY))>MOVE_THRESHOLD) cancel(); }
  el.addEventListener('touchstart',function(e){ var t=e.touches[0]; start(t.clientX,t.clientY); },{passive:true});
  el.addEventListener('touchmove',function(e){ var t=e.touches[0]; moved(t.clientX,t.clientY); },{passive:true});
  el.addEventListener('touchend',cancel); el.addEventListener('touchcancel',cancel);
  el.addEventListener('mousedown',function(e){ if(e.button!==0) return; start(e.clientX,e.clientY); });
  el.addEventListener('mousemove',function(e){ if(timer) moved(e.clientX,e.clientY); });
  el.addEventListener('mouseup',cancel); el.addEventListener('mouseleave',cancel);
  el.addEventListener('contextmenu',function(e){ if(triggered||timer) e.preventDefault(); });
}

