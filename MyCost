    <div class="modal-actions" style="margin-top:16px;">
      <button class="btn btn-secondary" id="calcCancel">取消</button>
      <button class="btn btn-primary" id="calcConfirm">填入金额</button>
    </div>
  </div>
</div>

<!-- 收支明细弹窗 -->
<div class="modal" id="detailModal">
  <div class="modal-content">
    <div class="modal-handle"></div>
    <div class="modal-title" id="detailTitle">支出明细</div>
    <div class="detail-tabs">
      <button class="detail-tab active expense" data-dtype="expense">支出</button>
      <button class="detail-tab income" data-dtype="income">收入</button>
    </div>
    <div class="detail-total" id="detailTotalBox">
      <div class="k" id="detailTotalLabel">总支出</div>
      <div class="v" id="detailTotal">¥0</div>
    </div>
    <div class="detail-chart" id="detailChart"></div>
    <div class="detail-legend" id="detailLegend"></div>
    <div class="modal-actions">
