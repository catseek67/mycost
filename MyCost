var cloudSyncTimer = null, cloudSyncing = false;

function pushToCloud(silent){
  var cfg = getCloudConfig();
  if(!cfg.binId || !cfg.binKey){ if(!silent) showToast('请先设置 Bin ID 和 Key'); return Promise.resolve(false); }
  if(cloudSyncing) return Promise.resolve(false);
  cloudSyncing = true;
  var payload = { version:6, updatedAt:new Date().toISOString(), transactions:state.transactions, savingGoal:state.savingGoal };
  return fetch('https://api.jsonbin.io/v3/b/'+cfg.binId, {
    method:'PUT', headers:{ 'Content-Type':'application/json', 'X-Master-Key':cfg.binKey },
    body: JSON.stringify(payload)
  }).then(function(res){
    if(!res.ok){ setCloudStatus('云同步失败，请检查配置','#E57373'); if(!silent) showToast('云同步失败'); cloudSyncing=false; return false; }
    var now = new Date(), t = pad2(now.getHours())+':'+pad2(now.getMinutes());
    setCloudStatus('☁️ 已同步 '+t, 'var(--green-soft)'); cloudSyncing = false; return true;
  }).catch(function(err){
    console.error(err);
    setCloudStatus('云同步失败（网络问题）','#E57373');
    if(!silent) showToast('网络异常，稍后自动重试');
    cloudSyncing = false; return false;
  });
}

function pullFromCloud(){
  var cfg = getCloudConfig();
  if(!cfg.binId || !cfg.binKey){ showToast('请先填写 Bin ID 和 Key'); return; }
  setCloudStatus('正在从云端读取…','var(--pink-6)');
  fetch('https://api.jsonbin.io/v3/b/'+cfg.binId+'/latest', { headers:{ 'X-Master-Key':cfg.binKey } })
    .then(function(res){ if(!res.ok){ setCloudStatus('读取失败','#E57373'); showToast('读取云端失败'); return null; } return res.json(); })
    .then(function(data){
      if(!data || !data.record) return;
      var record = data.record;
      if(!record.transactions || !Array.isArray(record.transactions)){ setCloudStatus('云端暂无数据','var(--text-3)'); showToast('云端没有数据'); return; }
      var count = record.transactions.length;
      if(!confirm('云端有 '+count+' 条记录，将覆盖本地。继续？')){ setCloudStatus('已取消恢复','var(--text-3)'); return; }
      state.transactions = record.transactions;
      if(record.savingGoal) state.savingGoal = record.savingGoal;
      saveState(); render();
      var now = new Date(), t = pad2(now.getHours())+':'+pad2(now.getMinutes());
      setCloudStatus('☁️ 已恢复 '+count+' 条 · '+t, 'var(--green-soft)');
      showToast('已从云端恢复 '+count+' 条记录 ✅');
    }).catch(function(err){ console.error(err); setCloudStatus('读取异常','#E57373'); showToast('读取失败'); });
}

function scheduleCloudSync(){
  var cfg = getCloudConfig();
  if(!cfg.binId || !cfg.binKey) return;
  clearTimeout(cloudSyncTimer);
  setCloudStatus('⏳ 即将同步…','var(--text-3)');
  cloudSyncTimer = setTimeout(function(){ pushToCloud(true); }, 2000);
}

