function updateCalcDisplay(){
  var expr = state.calcExpr || '';
  document.getElementById('calcExpr').textContent = expr;
  if(!expr){ document.getElementById('calcResult').textContent='0'; return; }
  var r = safeEval(expr);
  document.getElementById('calcResult').textContent = r!==null ? formatCalcNumber(r) : '…';
}
function formatCalcNumber(n){ if(!isFinite(n)) return '…'; if(Number.isInteger(n)) return n.toString(); return parseFloat(n.toFixed(8)).toString(); }
function safeEval(expr){
  var cleaned = expr.replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-').replace(/%/g,'/100');
  if(!/^[\d+\-*/.() ]+$/.test(cleaned)) return null;
  try{ var r = Function('"use strict"; return ('+cleaned+')')(); if(typeof r!=='number'||!isFinite(r)) return null; return r; }catch(e){ return null; }
}
