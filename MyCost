function buildDonutSVG(list,total,type){
  var cx=100,cy=100,rO=78,rI=48,angle=-Math.PI/2,paths='';
  list.forEach(function(item){
    var ratio=item.ratio; if(ratio<=0) return;
    var end=angle+ratio*Math.PI*2;
    if(ratio>=0.9999){ paths+='<circle cx="'+cx+'" cy="'+cy+'" r="'+((rO+rI)/2)+'" fill="none" stroke="'+item.color+'" stroke-width="'+(rO-rI)+'"/>'; angle=end; return; }
    var x1o=cx+rO*Math.cos(angle),y1o=cy+rO*Math.sin(angle);
    var x2o=cx+rO*Math.cos(end),y2o=cy+rO*Math.sin(end);
    var x1i=cx+rI*Math.cos(end),y1i=cy+rI*Math.sin(end);
    var x2i=cx+rI*Math.cos(angle),y2i=cy+rI*Math.sin(angle);
    var large=ratio>0.5?1:0;
    paths+='<path d="M '+x1o+' '+y1o+' A '+rO+' '+rO+' 0 '+large+' 1 '+x2o+' '+y2o+' L '+x1i+' '+y1i+' A '+rI+' '+rI+' 0 '+large+' 0 '+x2i+' '+y2i+' Z" fill="'+item.color+'" stroke="#fff" stroke-width="1.5"/>';
    angle=end;
  });
  var label = type==='expense'?'总支出':'总收入';
  var center = '<text x="'+cx+'" y="'+(cy-6)+'" text-anchor="middle" font-size="10" fill="#9A8A90" font-family="Quicksand, sans-serif" font-weight="600" letter-spacing="1">'+label+'</text><text x="'+cx+'" y="'+(cy+14)+'" text-anchor="middle" font-size="18" fill="#5A4A50" font-family="\'ZCOOL KuaiLe\', Quicksand, sans-serif" font-weight="700">¥'+formatShort(total)+'</text>';
  return '<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">'+paths+center+'</svg>';
}

